    ComputeEffectShader.ThreadNumbers: {X: 256, Y: 1, Z: 1}
    ComputeEffectShader.ComputeShaderName: ClearBuffer
---
!EffectCompileRequest
EffectName: ComputeEffectShader
UsedParameters:
    BufferToTexture.AttributesIndirect:
        - !ShaderMixinSource
            Mixins:
                - !ShaderClassSource
                    ClassName: VoxelAttributeEmissionOpacityShader
            Compositions:
                layout: !ShaderMixinSource
                    Mixins:
                        - !ShaderClassSource
                            ClassName: VoxelIsotropicWriter_Float4
                    Compositions:
                        writer: !ShaderMixinSource
                            Mixins:
                                - !ShaderClassSource
                                    ClassName: VoxelFragmentPackFloatR11G11B10
                            Compositions:
                                writer: !ShaderClassSource
                                    ClassName: VoxelBufferWriteMax
    BufferToTexture.AttributesTemp: []
    BufferToTexture.IndirectReadAndStoreMacro: |+
        AttributesIndirect[0].InitializeFromBuffer(VoxelFragments, VoxelFragmentsIndex + 0, uint2(0 + initialVoxelFragmentsIndex, yStride));
        streams.LocalSample[0] = AttributesIndirect[0].SampleLocal();

    BufferToTexture.IndirectStoreMacro: |
        streams.LocalSample[0] = AttributesIndirect[0].SampleLocal();
    ComputeEffectShader.ThreadNumbers: {X: 256, Y: 1, Z: 1}
    ComputeEffectShader.ComputeShaderName: BufferToBricksEffect
---
!EffectCompileRequest
EffectName: ComputeEffectShader
UsedParameters:
    Voxel2x2x2Mipmap.mipmapper: !ShaderClassSource
        ClassName: Voxel2x2x2MipmapperHeuristic
    ComputeEffectShader.ThreadNumbers: {X: 1, Y: 1, Z: 1}
    ComputeEffectShader.ComputeShaderName: Voxel2x2x2MipmapEffect
