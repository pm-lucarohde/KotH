                - !ShaderClassSource
                    ClassName: ShadowMapFilterPcf
                    GenericArguments: [PerView.Lighting, 5]
        - !ShaderMixinSource
            Mixins:
                - !ShaderClassSource
                    ClassName: LightDirectionalGroup
                    GenericArguments: [1]
                - !ShaderClassSource
                    ClassName: CascadeShadowReceiver
                    GenericArguments: [4, 1, true, false, false, false]
                - !ShaderClassSource
                    ClassName: ShadowMapFilterPcf
                    GenericArguments: [PerView.Lighting, 5]
        - !ShaderClassSource
            ClassName: LightClusteredPointGroup
        - !ShaderClassSource
            ClassName: LightClusteredSpotGroup
    Lighting.EnvironmentLights:
        - !ShaderClassSource
            ClassName: LightSimpleAmbient
        - !ShaderClassSource
            ClassName: EnvironmentLight
        - !ShaderMixinGeneratorSource
            Name: LightVoxelEffect
    LightVoxelShader.diffuseMarcher.environmentLights[2]: !ShaderMixinSource
        Mixins:
            - !ShaderClassSource
                ClassName: VoxelMarchSetHemisphere6
        Compositions:
            Marcher: !ShaderMixinSource
                Mixins:
                    - !ShaderClassSource
                        ClassName: VoxelMarchConePerMipmap
                        GenericArguments: [7]
                Compositions:
                    AttributeSamplers: !ShaderArraySource
                        Values:
                            - !ShaderMixinSource
                                Mixins:
                                    - !ShaderClassSource
                                        ClassName: VoxelIsotropicSampler
                                Compositions:
                                    storage: !ShaderClassSource
                                        ClassName: VoxelStorageTextureSparseShader
                                        GenericArguments: [0.125]
                Macros:
                    -   Name: AttributeID
                        Definition: 0
    LightVoxelShader.specularMarcher.environmentLights[2]: !ShaderMixinSource
        Mixins:
            - !ShaderClassSource
                ClassName: VoxelMarchCone
                GenericArguments: [30, 0.5, 1, 1]
        Compositions:
            AttributeSamplers: !ShaderArraySource
                Values:
                    - !ShaderMixinSource
                        Mixins:
                            - !ShaderClassSource
                                ClassName: VoxelIsotropicSampler
                        Compositions:
                            storage: !ShaderClassSource
                                ClassName: VoxelStorageTextureSparseShader
                                GenericArguments: [0.125]
        Macros:
            -   Name: sampleFunction
                Definition: Sample
            -   Name: AttributeID
                Definition: 0
    VoxelizeToFragments.Storage: !ShaderMixinSource
        Mixins:
            - !ShaderClassSource
                ClassName: VoxelStorageSparseShader
        Compositions:
            AttributesIndirect: !ShaderArraySource
                Values:
                    - !ShaderMixinSource
                        Mixins:
                            - !ShaderClassSource
                                ClassName: VoxelAttributeEmissionOpacityShader
                        Compositions:
                            layout: !ShaderMixinSource
                                Mixins:
                                    - !ShaderClassSource
                                        ClassName: VoxelIsotropicWriter_Float4
                                Compositions:
                                    writer: !ShaderMixinSource
                                        Mixins:
                                            - !ShaderClassSource
                                                ClassName: VoxelFragmentPackFloatR11G11B10
                                        Compositions:
                                            writer: !ShaderClassSource
                                                ClassName: VoxelBufferWriteMax
            method: !ShaderMixinSource
                Mixins:
                    - !ShaderClassSource
                        ClassName: VoxelizationMethodDominantAxis
        Macros:
            -   Name: SparseMark
                Definition: True
            -   Name: IndirectStoreMacro
                Definition: |
                    AttributesIndirect[0].IndirectWrite(fragmentsBuffer, writeindex + 0);
    VoxelizeToFragments.RequireGeometryShader: true
    VoxelizeToFragments.GeometryShaderMaxVertexCount: 3
