/// <summary>AtmosphereComposite and Stride's RangeCompressorShader in one pass, while nothing is drawn between
/// them (no sun shafts, no shimmer): the scene (Texture2) under the fog as the blend did it, held to half
/// precision as its target held it, then compressed for FXAA with the luma in alpha.</summary>
shader AtmosphereCompress : AtmosphereComposite, HalfPrecisionUtils
{
    stage override float4 Shading()
    {
        float4 fog = base.Shading();
        float3 scene = Texture2.Load(int3(int2(streams.ShadingPosition.xy), 0)).rgb;
        float3 color = f16tof32(f32tof16(fog.rgb + scene * fog.a));
        color = ClampToSafeRange(color);
        float perceptiveLuma = sqrt(dot(float3(0.2126, 0.7152, 0.0722), color));
        float maxComponent = max(max(color.r, color.g), color.b);
        return float4(color / (1 + maxComponent / 1.0), perceptiveLuma);
    }
};
