/// <summary>
/// Stride's vignette with its own start at the sides and at top and bottom (Luca:
/// later above and below). Distance from the centre in UV, 1 at the corners; the
/// start blends from RadiusSides to RadiusTopBottom by the direction (cos²).
/// </summary>
shader OvalVignette : ColorTransformShader, Texturing
{
    float Amount;
    float RadiusSides;
    float RadiusTopBottom;
    [Color]
    float3 Color;

    override float4 Compute(float4 color)
    {
        float2 d = streams.TexCoord - float2(0.5, 0.5);
        float square = dot(d, d);
        float across = square > 0.0 ? d.x * d.x / square : 1.0;
        float begin = lerp(RadiusTopBottom, RadiusSides, across);
        float vignette = smoothstep(begin, 1.0, sqrt(square) / 0.7071) * Amount;
        color.rgb = color.rgb * (1.0 - vignette) + vignette * Color;
        return color;
    }
};
