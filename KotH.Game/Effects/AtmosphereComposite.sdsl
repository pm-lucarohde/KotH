/// <summary>
/// Lays AtmosphereMarch's half-resolution fog and clouds over the scene:
/// blended as scene * a + rgb (AtmosphereEffects sets the blend). Texture0
/// is the half-resolution result, Texture1 the full depth; the 3 x 3 nearest
/// half pixels count by a tent 1.5 half pixels wide (it evens out the march's
/// jitter on thin cloud edges, Luca) and by how close their depth is to this
/// pixel's, so the mountain's edge against the sky stays sharp.
/// </summary>
shader AtmosphereComposite : ImageEffectShader
{
    float2 NearFar;

    float Linear(float z)
    {
        return NearFar.x * NearFar.y / (NearFar.y - z * (NearFar.y - NearFar.x));
    }

    stage override float4 Shading()
    {
        int2 pixel = int2(streams.ShadingPosition.xy);
        float own = Linear(Texture1.Load(int3(pixel, 0)).r);
        float2 halfSize = 1.0 / Texture0TexelSize;
        float2 at = (float2(pixel) + 0.5) * 0.5 - 0.5;
        int2 nearest = int2(round(at));
        float4 sum = 0;
        float total = 0;
        for (int j = -1; j <= 1; j++)
        {
            for (int i = -1; i <= 1; i++)
            {
                int2 tap = clamp(nearest + int2(i, j), 0, int2(halfSize) - 1);
                float depth = Linear(Texture1.Load(int3(tap * 2, 0)).r);
                float2 tent = max(1.5 - abs(float2(nearest + int2(i, j)) - at), 0.0);
                float w = tent.x * tent.y / (0.05 + abs(depth - own) / own) + 1e-4;
                sum += w * Texture0.Load(int3(tap, 0));
                total += w;
            }
        }
        return sum / total;
    }
};
