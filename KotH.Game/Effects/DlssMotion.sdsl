/// <summary>Motion vectors for DLSS: where geometry is, DlssObjectVelocity's; at the far plane (sky) from
/// depth and the camera alone, the point found with the jittered projection and seen by the
/// unjittered one now and before. Out in UV (previous minus current), red right, green down.</summary>
shader DlssMotion : ImageEffectShader
{
    float4x4 ClipToView;
    float4x4 ViewToClip;
    float4x4 ViewToPrevClip;

    stage override float4 Shading()
    {
        float depth = Texture0.SampleLevel(PointSampler, streams.TexCoord, 0).r;
        if (depth < 1.0)
            return float4(Texture1.SampleLevel(PointSampler, streams.TexCoord, 0).rg, 0.0, 0.0);
        float2 ndc = float2(streams.TexCoord.x * 2.0 - 1.0, 1.0 - streams.TexCoord.y * 2.0);
        float4 view = mul(float4(ndc, depth, 1.0), ClipToView);
        view /= view.w;
        float4 now = mul(view, ViewToClip);
        float4 before = mul(view, ViewToPrevClip);
        float2 motion = (before.xy / before.w - now.xy / now.w) * float2(0.5, -0.5);
        return float4(motion, 0.0, 0.0);
    }
};
