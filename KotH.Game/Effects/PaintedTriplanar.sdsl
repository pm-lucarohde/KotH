/// <summary>
/// One painted texture projected from three sides (triplanar), for leaves and
/// bark; TEXCOORD0.x is the shade (soft AO). The alpha is the texture's: the
/// leaves' material cuts off the clear ground between the leaves. Where
/// TEXCOORD0.y is 1 (leaves) the painting moves a little in the wind.
/// </summary>
shader PaintedTriplanar<LinkType PaintKey>
    : ComputeColor, PositionStream4, NormalStream, Texturing
{
    // Metres per repeat of the texture.
    static const float TileSize = 2.0;
    // A quarter mip level sharper, as in TerrainTriplanar.
    static const float Bias = -0.25;
    // Wind: metres the leaves move, as a slow sway of whole patches and a
    // quicker flutter of single leaves, never in step from place to place.
    static const float SwayReach = 0.03;
    static const float FlutterReach = 0.008;
    // Share of the first draft's pace (Luca: 60 %).
    static const float WindPace = 0.6;

    float3 Wind(float3 q, float t)
    {
        float gust = 0.65 + 0.35 * sin(t * 0.37 + q.x * 0.11 + q.z * 0.07);
        float3 sway = float3(sin(t * 1.9 + q.x * 2.3 + q.y * 1.7),
                             0.5 * sin(t * 1.4 + q.y * 2.1 + q.z * 1.3),
                             sin(t * 1.6 + q.z * 2.6 - q.x * 1.1));
        float3 flutter = float3(sin(t * 7.3 + q.y * 9.1 + q.z * 6.7),
                                sin(t * 6.1 + q.x * 8.3 - q.z * 7.9),
                                sin(t * 8.2 + q.x * 7.1 + q.y * 9.7));
        return gust * (SwayReach * sway + FlutterReach * flutter);
    }

    rgroup PerMaterial
    {
        [Link("PaintKey")] stage Texture2D Paint;
    }

    override float4 Compute()
    {
        float shade = streams.TexCoord.x;
        float3 n = normalize(streams.normalWS);
        float3 q = streams.PositionWS.xyz;
        float3 p = (q + streams.TexCoord.y * Wind(q, Global.Time * WindPace)) / TileSize;
        float3 b = pow(abs(n), 8.0);
        b /= b.x + b.y + b.z;
        float4 c = b.x * Paint.SampleBias(AnisotropicRepeatSampler, float2(p.z, -p.y), Bias)
                 + b.y * Paint.SampleBias(AnisotropicRepeatSampler, p.xz, Bias)
                 + b.z * Paint.SampleBias(AnisotropicRepeatSampler, float2(p.x, -p.y), Bias);
        return float4(c.rgb * shade, c.a);
    }
};
