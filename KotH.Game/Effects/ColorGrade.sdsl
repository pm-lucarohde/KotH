/// <summary>Contrast as a power about a fixed linear grey (0.3, about the mean of a sunny
/// view, so the image keeps its brightness), then brightness as a factor. Linear colour.</summary>
shader ColorGrade : ColorTransformShader
{
    float Contrast;
    float Brightness;

    override float4 Compute(float4 color)
    {
        color.rgb = 0.3 * pow(max(color.rgb, 0.0) / 0.3, Contrast) * Brightness;
        return color;
    }
};
