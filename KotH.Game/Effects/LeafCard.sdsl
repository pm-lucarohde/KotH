/// <summary>
/// The twigs that stand out of the crowns (mountain.py's cards, LeafSprig.png),
/// after the "bushy leaves" resource packs: the twig on its card, cut out by
/// the material, darker at the base inside the crown. The twig moves with
/// LeafSplat's wind at its place (sway and flutter), held only where it
/// enters the crown; u runs from a whole number to the next per card.
/// </summary>
shader LeafCard<LinkType PaintKey>
    : ComputeColor, PositionStream4, Texturing, LeafWind
{
    // About a card's width in metres (mountain.py: 0.8 of 0.72-1.035 m), to turn the wind into uv.
    static const float CardWidth = 0.7;

    rgroup PerMaterial
    {
        [Link("PaintKey")] stage Texture2D Paint;
    }

    override float4 Compute()
    {
        float2 uv = streams.TexCoord;
        float tip = 1.0 - uv.y;
        // Out of the crown (the base third is inside) it moves as the leaves do.
        float free = saturate(tip * 1.5);
        float3 w = Wind(streams.PositionWS.xyz, Global.Time * WindPace);
        uv -= free * float2(w.x + w.z, w.y) / CardWidth;
        float4 c = Paint.Sample(AnisotropicRepeatSampler, uv);
        return float4(c.rgb * lerp(0.7, 1.0, free), c.a);
    }
};
