/// <summary>
/// Stride's directional shadow receiver with the bias measured per cascade,
/// a receiver plane depth bias and soft shadows like PCSS. Stride subtracts
/// DepthBias as a share of the cascade's depth range (a few centimetres near,
/// metres far), offsets along the normal by atlas texels and compares all PCF
/// taps with the pixel's own depth, so a sloped face shadows itself inside the
/// kernel and steps at every edge. Here each tap follows the triangle's plane;
/// DepthBias is in metres and NormalOffsetScale adds a depth bias in texels of
/// the cascade sampled. The blockers within 4 texels set the penumbra
/// (SunTangent per metre between blocker and receiver, at most 4 texels),
/// filtered over a disk. The scene's shadow filter must be PCF (size unused).
/// With a static map (StaticSunShadowRenderer) the cascades hold only what
/// moves, and the map's shadow from the static map is multiplied in, filtered alike;
/// lightmapped meshes (KOTH_LIGHTMAP) read it baked per texel instead, as a cubic
/// B-spline (four bilinear reads), so the texels do not show as steps. Both
/// disks turn by a noise angle per pixel: steps at their rims become fine grain.
/// The clouds' shadow (Atmosphere) is multiplied in last, never baked: they drift.
/// </summary>
shader CascadeShadowReceiver<int TCascadeCount,
                             int TLightCount,
                             bool TBlendCascades,
                             bool TDepthRangeAuto,
                             bool TCascadeDebug,
                             bool TComputeTransmittance> :
    ShadowMapReceiverDirectional<TCascadeCount, TLightCount, TBlendCascades, TDepthRangeAuto, TCascadeDebug, TComputeTransmittance>,
    Texturing, ShaderBaseStream, LightmapBakeStream, CloudLayer
{
    cbuffer PerView.Lighting
    {
        float4 CascadeRects[TCascadeCount * TLightCount];   // atlas uv: left, top, right, bottom
        float SunTangent;     // penumbra metres per metre between blocker and receiver
        float MaxPenumbra;    // widest penumbra radius in texels, also the static map's search reach (cascades: BlockerReach)
        float4x4 WorldToStaticUV;
        float2 StaticTexelSize;   // 0 without a static map
        float2 SunLightmapTexelSize;
        float4 CloudShadowLayer;  // base, thickness, coverage, density
        float4 CloudShadowScale;  // 1 / repeat of cloudlets and streaks, strength (0: no clouds), 0
        float4 CloudShadowOffset;
        float2 CloudShadowWind;
        float3 CloudShadowToSun;
    };

    rgroup PerView.Lighting
    {
        Texture2D StaticShadowMap;
        Texture2D SunLightmap;      // red: the static shadow baked per lightmap texel
        Texture2D CloudShadowMap;
    }

    stream float3 shadowFacetNormalWS;

    // Called once before the cascade branches, where derivatives are still defined:
    // keeps the triangle's normal (its sign does not matter) and moves nothing.
    override float3 GetShadowPositionOffset(float offsetScale, float nDotL, float3 normal)
    {
        streams.shadowFacetNormalWS = cross(ddx(streams.PositionWS.xyz), ddy(streams.PositionWS.xyz));
        return 0;
    }

    override float3 ComputeShadow(float3 position, int lightIndex)
    {
#ifdef KOTH_LIGHTMAP_BAKE
        // Baking: only the map's shadow, kept apart; nothing that moves.
        streams.shadowFacetNormalWS = cross(ddx(streams.PositionWS.xyz), ddy(streams.PositionWS.xyz));
        if (StaticTexelSize.x > 0.0)
            streams.bakedSun = StaticShadow(position, lightIndex);
        return 1.0;
#else
        float3 shadow = base.ComputeShadow(position, lightIndex);
#ifdef KOTH_LIGHTMAP
        shadow *= SunLightmapCubic(streams.TexCoord1);
#else
        if (StaticTexelSize.x > 0.0)
            shadow *= StaticShadow(position, lightIndex);
#endif
        if (CloudShadowScale.z > 0.0)
            shadow *= CloudShadow(position);
        return shadow;
#endif
    }

    // Through the cloudlet the sun crosses on its way down: the point is taken up
    // to the layer's middle along the sun and the map read a few mips blurred, so
    // the shadow is soft; it fades in below the layer and is gone above it.
    float CloudShadow(float3 positionWS)
    {
        float lowest = CloudShadowLayer.x, thickness = CloudShadowLayer.y;
        float middle = lowest + 0.5 * thickness;
        float below = saturate((middle - positionWS.y) / thickness);
        if (below <= 0.0)
            return 1.0;
        float up = max(CloudShadowToSun.y, 0.05);
        float2 xz = positionWS.xz + CloudShadowToSun.xz * ((middle - positionWS.y) / up);
        float4 uv = CloudUV(xz, CloudShadowWind, CloudShadowScale.xy, CloudShadowOffset);
        float cell = CloudShadowMap.SampleLevel(LinearRepeatSampler, uv.xy, 3.0).r;
        float band = CloudShadowMap.SampleLevel(LinearRepeatSampler, uv.zw, 1.0).g;
        float top = CloudTop(cell, band, CloudShadowLayer.z);
        float through = exp(-CloudShadowLayer.w * 1.25 * top * thickness / up);
        return 1.0 - CloudShadowScale.z * below * (1.0 - through);
    }

    // The static map like one more cascade over all, nothing outside of it.
    float StaticShadow(float3 positionWS, int lightIndex)
    {
        float4 shadowPosition;
        float2 gradient;
        float depthPerMetre, texel;
        Project(positionWS, WorldToStaticUV, StaticTexelSize.x, lightIndex, shadowPosition, gradient, depthPerMetre, texel);
        if (any(shadowPosition.xy < 0.0) || any(shadowPosition.xy > 1.0))
            return 1.0;
        float4 rect = float4(0.5 * StaticTexelSize, 1.0 - 0.5 * StaticTexelSize);
        float gap = StaticBlockerGap(shadowPosition.xyz, gradient, rect);
        if (gap < 0.0)
            return gap < -1.5 ? 0.0 : 1.0;
        float radius = clamp(gap / depthPerMetre * SunTangent / texel, 1.5, MaxPenumbra);
        return StaticFilterDisk(shadowPosition.xyz, gradient, radius, rect);
    }

    // Position in the map (biased), the receiver plane's depth gradient, depth
    // units per metre and the texel's width in metres.
    void Project(float3 positionWS, float4x4 toUV, float texelUV, int lightIndex,
                 out float4 shadowPosition, out float2 gradient, out float depthPerMetre, out float texel)
    {
        float3 axisU = float3(toUV._11, toUV._21, toUV._31);
        float3 axisV = float3(toUV._12, toUV._22, toUV._32);
        float3 axisZ = float3(toUV._13, toUV._23, toUV._33);

        // Map units per metre across and along the light give the texel and depth scales.
        float uvPerMetre = length(axisU);
        depthPerMetre = length(axisZ);
        texel = texelUV / uvPerMetre;
        float bias = DepthBiases[lightIndex] + OffsetScales[lightIndex] * texel;

        shadowPosition = mul(float4(positionWS, 1.0), toUV);
        shadowPosition.z -= bias * depthPerMetre;

        // The plane's depth change per atlas unit: the shadow axes are orthogonal, so the
        // normal maps to (a_i . n) / |a_i|^2. Steeper than 10:1 to the light is clamped.
        float3 n = streams.shadowFacetNormalWS;
        float nz = dot(axisZ, n) / (depthPerMetre * depthPerMetre);
        float2 nuv = float2(dot(axisU, n), dot(axisV, n)) / (uvPerMetre * uvPerMetre);
        float limit = 10.0 * depthPerMetre / uvPerMetre;
        gradient = clamp(-nuv / (abs(nz) > 1e-12 ? nz : 1e-12), -limit, limit);
    }

    override float ComputeShadowFromCascade(float3 shadowPositionWS, int cascadeIndex, int lightIndex)
    {
        int index = cascadeIndex + lightIndex * TCascadeCount;
        float4 shadowPosition;
        float2 gradient;
        float depthPerMetre, texel;
        Project(shadowPositionWS, WorldToShadowCascadeUV[index], ShadowMapTextureTexelSize.x, lightIndex,
                shadowPosition, gradient, depthPerMetre, texel);

        // Taps stay half a texel inside this cascade's rectangle of the atlas.
        float4 rect = CascadeRects[index] + float4(0.5 * ShadowMapTextureTexelSize, -0.5 * ShadowMapTextureTexelSize);
        float gap = BlockerGap(shadowPosition.xyz, gradient, rect);
        if (gap < 0.0)
            return gap < -1.5 ? 0.0 : 1.0;
        float radius = clamp(gap / depthPerMetre * SunTangent / texel, 1.5, min(MaxPenumbra, BlockerReach));
        return FilterDisk(shadowPosition.xyz, gradient, radius, rect);
    }

    // The cascades' blocker search reaches this many texels, every texel: wider,
    // the 4x4 gathers left gaps, and a figure moving less than a texel flipped the
    // penumbra between soft and hard at the shadow's rim. The disk no wider, its rim
    // would end in a step (wider takes a blocker gap of 5 m).
    static const float BlockerReach = 4.0;

    // Mean depth from the blockers to the receiver's plane over 4x4 gathers reaching
    // BlockerReach texels round the pixel; -1 when nothing blocks, -2 when all do.
    // Each texel weighs by a tent over its distance, nothing at the reach: so the
    // mean changes smoothly with the pixel and the caster, not texel by texel
    // (whole texels flipped between penumbrae as large squares at the rim).
    float BlockerGap(float3 position, float2 gradient, float4 rect)
    {
        float2 step = 0.5 * BlockerReach * ShadowMapTextureTexelSize;
        float2 halfTexel = 0.5 * ShadowMapTextureTexelSize;
        float4 corners = float4(dot(float2(-halfTexel.x, halfTexel.y), gradient), dot(halfTexel, gradient),
                                dot(float2(halfTexel.x, -halfTexel.y), gradient), dot(-halfTexel, gradient));
        float sum = 0;
        float count = 0;
        float all = 0;
        for (int j = 0; j < 4; j++)
        {
            for (int i = 0; i < 4; i++)
            {
                // Snapped to a texel corner, so the gather takes the four texels round it.
                float2 uv = clamp(position.xy + (float2(i, j) - 1.5) * step, rect.xy + halfTexel, rect.zw - halfTexel);
                uv = (floor(uv * ShadowMapTextureSize - 0.5) + 1.0) * ShadowMapTextureTexelSize;
                float4 stored = ShadowMapTexture.GatherRed(PointSampler, uv);
                float4 receiver = position.z + dot(uv - position.xy, gradient) + corners;
                float4 blocked = stored < receiver ? 1.0 : 0.0;
                // The gathered texels' centres in texels from the pixel (order of GatherRed).
                float2 d = (uv - position.xy) * ShadowMapTextureSize;
                float4 weight = saturate(1.0 - abs(d.x + float4(-0.5, 0.5, 0.5, -0.5)) / BlockerReach)
                              * saturate(1.0 - abs(d.y + float4(0.5, 0.5, -0.5, -0.5)) / BlockerReach);
                sum += dot(blocked * weight, receiver - stored);
                count += dot(blocked, weight);
                all += dot(blocked, 1.0);
            }
        }
        return count <= 0.0 ? -1.0 : all == 64 ? -2.0 : sum / count;
    }

    // The baked sun as a cubic B-spline: four bilinear reads, each placed between
    // two texels so its weights come out (GPU Gems 2, ch. 20).
    float SunLightmapCubic(float2 uv)
    {
        float2 p = uv / SunLightmapTexelSize - 0.5;
        float2 f = frac(p);
        p -= f;
        float2 g = 1.0 - f;
        float2 w0 = g * g * g / 6.0, w3 = f * f * f / 6.0;
        float2 w1 = (4.0 - 6.0 * f * f + 3.0 * f * f * f) / 6.0, w2 = 1.0 - w0 - w1 - w3;
        float2 s0 = w0 + w1, s1 = w2 + w3;
        float2 a = (p - 0.5 + w1 / s0) * SunLightmapTexelSize;
        float2 b = (p + 1.5 + w3 / s1) * SunLightmapTexelSize;
        return s0.y * (s0.x * SunLightmap.SampleLevel(LinearSampler, a, 0).r + s1.x * SunLightmap.SampleLevel(LinearSampler, float2(b.x, a.y), 0).r)
             + s1.y * (s0.x * SunLightmap.SampleLevel(LinearSampler, float2(a.x, b.y), 0).r + s1.x * SunLightmap.SampleLevel(LinearSampler, b, 0).r);
    }

    // A noise turn per pixel (interleaved gradient noise) as cos, sin, one of two:
    // the 64 taps are two disks of 32, each with its own turn (Luca); their angles
    // stay constants. The bake keeps them still, the second half a golden angle on.
    float2 Twist(float which)
    {
#ifdef KOTH_LIGHTMAP_BAKE
        float angle = which * 1.19998;
#else
        float2 pixel = streams.ShadingPosition.xy + which * float2(47.0, 17.0);
        float angle = 6.2831853 * frac(52.9829189 * frac(dot(pixel, float2(0.06711056, 0.00583715))));
#endif
        return float2(cos(angle), sin(angle));
    }

    // 64 bilinear comparisons on two Vogel disks of the radius (texels), weighted
    // towards the centre like a tent, so the penumbra fades without a rim.
    float FilterDisk(float3 position, float2 gradient, float radius, float4 rect)
    {
        float2 scale = radius * ShadowMapTextureTexelSize;
        float shadow = 0;
        float total = 0;
        float2 twists[2] = { Twist(0.0), Twist(1.0) };
        for (int k = 0; k < 64; k++)
        {
            float r2 = ((k >> 1) + 0.5) / 32.0;
            float a = (k >> 1) * 2.39996;
            float2 e = float2(cos(a), sin(a));
            float2 twist = twists[k & 1];
            float2 d = sqrt(r2) * float2(e.x * twist.x - e.y * twist.y, e.x * twist.y + e.y * twist.x);
            float weight = 1.0 - 0.75 * r2;
            float2 uv = clamp(position.xy + d * scale, rect.xy, rect.zw);
            shadow += weight * Tap(uv, position, gradient);
            total += weight;
        }
        return shadow / total;
    }

    float Tap(float2 tapUV, float3 position, float2 gradient)
    {
        float depth = position.z + dot(tapUV - position.xy, gradient);
        return ShadowMapTexture.SampleCmpLevelZero(LinearClampCompareLessEqualSampler, tapUV, depth);
    }

    // The same over the static map.
    float StaticBlockerGap(float3 position, float2 gradient, float4 rect)
    {
        float2 step = 0.5 * MaxPenumbra * StaticTexelSize;
        float2 halfTexel = 0.5 * StaticTexelSize;
        float4 corners = float4(dot(float2(-halfTexel.x, halfTexel.y), gradient), dot(halfTexel, gradient),
                                dot(float2(halfTexel.x, -halfTexel.y), gradient), dot(-halfTexel, gradient));
        float sum = 0;
        float count = 0;
        for (int j = 0; j < 4; j++)
        {
            for (int i = 0; i < 4; i++)
            {
                // Snapped to a texel corner, so the gather takes the four texels round it.
                float2 uv = clamp(position.xy + (float2(i, j) - 1.5) * step, rect.xy + halfTexel, rect.zw - halfTexel);
                uv = (floor(uv * (1.0 / StaticTexelSize) - 0.5) + 1.0) * StaticTexelSize;
                float4 stored = StaticShadowMap.GatherRed(PointSampler, uv);
                float4 receiver = min(position.z + dot(uv - position.xy, gradient) + corners, 1.0);
                float4 blocked = stored < receiver ? 1.0 : 0.0;
                sum += dot(blocked, receiver - stored);
                count += dot(blocked, 1.0);
            }
        }
        return count == 0 ? -1.0 : count == 64 ? -2.0 : sum / count;
    }

    // 64 bilinear comparisons on two Vogel disks of the radius (texels), weighted
    // towards the centre like a tent, so the penumbra fades without a rim.
    float StaticFilterDisk(float3 position, float2 gradient, float radius, float4 rect)
    {
        float2 scale = radius * StaticTexelSize;
        float shadow = 0;
        float total = 0;
        float2 twists[2] = { Twist(0.0), Twist(1.0) };
        for (int k = 0; k < 64; k++)
        {
            float r2 = ((k >> 1) + 0.5) / 32.0;
            float a = (k >> 1) * 2.39996;
            float2 e = float2(cos(a), sin(a));
            float2 twist = twists[k & 1];
            float2 d = sqrt(r2) * float2(e.x * twist.x - e.y * twist.y, e.x * twist.y + e.y * twist.x);
            float weight = 1.0 - 0.75 * r2;
            float2 uv = clamp(position.xy + d * scale, rect.xy, rect.zw);
            shadow += weight * StaticTap(uv, position, gradient);
            total += weight;
        }
        return shadow / total;
    }

    // Beyond the far plane (the sea far off) is behind every caster: the cleared
    // depth means nothing is there, so the receiver is held to it.
    float StaticTap(float2 tapUV, float3 position, float2 gradient)
    {
        float depth = min(position.z + dot(tapUV - position.xy, gradient), 1.0);
        return StaticShadowMap.SampleCmpLevelZero(LinearClampCompareLessEqualSampler, tapUV, depth);
    }
};
