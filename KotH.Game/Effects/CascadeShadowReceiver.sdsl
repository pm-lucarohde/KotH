/// <summary>Stride's directional shadow receiver: the figures' shadow from the cascades is read per pixel
/// from FigureShadowMask (drawn after the depth prepass), the static map's is multiplied in (lightmapped
/// meshes read it baked, bicubic; else PCSS with a receiver plane per tap, disks turned per pixel), the
/// clouds' shadow comes last, live.</summary>
shader CascadeShadowReceiver<int TCascadeCount,
                             int TLightCount,
                             bool TBlendCascades,
                             bool TDepthRangeAuto,
                             bool TCascadeDebug,
                             bool TComputeTransmittance> :
    ShadowMapReceiverDirectional<TCascadeCount, TLightCount, TBlendCascades, TDepthRangeAuto, TCascadeDebug, TComputeTransmittance>,
    Texturing, ShaderBaseStream, LightmapBakeStream, CloudLayer, SunShadowCommon
{
    cbuffer PerView.Lighting
    {
        float2 FigureShadowSize;   // the mask's size in pixels; 0 where the view has none
        float SunTangent;     // penumbra metres per metre between blocker and receiver
        float MaxPenumbra;    // widest penumbra radius in texels, also the static map's search reach
        float4x4 WorldToStaticUV;
        float2 StaticTexelSize;   // 0 without a static map
        float2 SunLightmapTexelSize;
        float4 CloudShadowLayer;  // base, thickness, coverage, density
        float4 CloudShadowScale;  // 1 / repeat of cloudlets and streaks, strength (0: no clouds), 0
        float4 CloudShadowOffset;
        float2 CloudShadowWind;
        float3 CloudShadowToSun;
    };

    rgroup PerView.Lighting
    {
        Texture2D StaticShadowMap;
        Texture2D SunLightmap;      // red: the static shadow baked per lightmap texel
        Texture2D CloudShadowMap;
        Texture2D FigureShadow;
    }

    stream float3 shadowFacetNormalWS;

    // The triangle's normal before any branch, where derivatives are defined (its sign does not matter).
    override float3 ComputeShadow(float3 position, int lightIndex)
    {
        streams.shadowFacetNormalWS = cross(ddx(streams.PositionWS.xyz), ddy(streams.PositionWS.xyz));
#ifdef KOTH_LIGHTMAP_BAKE
        // Baking: only the map's shadow, kept apart; nothing that moves.
        if (StaticTexelSize.x > 0.0)
            streams.bakedSun = StaticShadow(position, lightIndex);
        return 1.0;
#else
        float3 shadow = FigureShadowSize.x > 0.0 ? FigureShadow.Load(int3(streams.ShadingPosition.xy, 0)).r : 1.0;
#ifdef KOTH_LIGHTMAP
        shadow *= SunLightmapCubic(streams.TexCoord1);
#else
        if (StaticTexelSize.x > 0.0)
            shadow *= StaticShadow(position, lightIndex);
#endif
        if (CloudShadowScale.z > 0.0)
            shadow *= CloudShadow(position);
        return shadow;
#endif
    }

    // Through the cloudlet the sun crosses on its way down: the point is taken up
    // to the layer's middle along the sun and the map read a few mips blurred, so
    // the shadow is soft; it fades in below the layer and is gone above it.
    float CloudShadow(float3 positionWS)
    {
        float lowest = CloudShadowLayer.x, thickness = CloudShadowLayer.y;
        float middle = lowest + 0.5 * thickness;
        float below = saturate((middle - positionWS.y) / thickness);
        if (below <= 0.0)
            return 1.0;
        float up = max(CloudShadowToSun.y, 0.05);
        float2 xz = positionWS.xz + CloudShadowToSun.xz * ((middle - positionWS.y) / up);
        float4 uv = CloudUV(xz, CloudShadowWind, CloudShadowScale.xy, CloudShadowOffset);
        float cell = CloudShadowMap.SampleLevel(LinearRepeatSampler, uv.xy, 3.0).r;
        float band = CloudShadowMap.SampleLevel(LinearRepeatSampler, uv.zw, 1.0).g;
        float top = CloudTop(cell, band, CloudShadowLayer.z);
        float through = exp(-CloudShadowLayer.w * 1.25 * top * thickness / up);
        return 1.0 - CloudShadowScale.z * below * (1.0 - through);
    }

    // The static map like one more cascade over all, nothing outside of it.
    float StaticShadow(float3 positionWS, int lightIndex)
    {
        float4 shadowPosition;
        float2 gradient;
        float depthPerMetre, texel;
        ProjectToMap(positionWS, WorldToStaticUV, StaticTexelSize.x, DepthBiases[lightIndex], OffsetScales[lightIndex],
                     streams.shadowFacetNormalWS, shadowPosition, gradient, depthPerMetre, texel);
        if (any(shadowPosition.xy < 0.0) || any(shadowPosition.xy > 1.0))
            return 1.0;
        float4 rect = float4(0.5 * StaticTexelSize, 1.0 - 0.5 * StaticTexelSize);
        float gap = StaticBlockerGap(shadowPosition.xyz, gradient, rect);
        if (gap < 0.0)
            return gap < -1.5 ? 0.0 : 1.0;
        float radius = clamp(gap / depthPerMetre * SunTangent / texel, 1.5, MaxPenumbra);
        return StaticFilterDisk(shadowPosition.xyz, gradient, radius, rect);
    }

    // The baked sun as a cubic B-spline: four bilinear reads, each placed between
    // two texels so its weights come out (GPU Gems 2, ch. 20).
    float SunLightmapCubic(float2 uv)
    {
        float2 p = uv / SunLightmapTexelSize - 0.5;
        float2 f = frac(p);
        p -= f;
        float2 g = 1.0 - f;
        float2 w0 = g * g * g / 6.0, w3 = f * f * f / 6.0;
        float2 w1 = (4.0 - 6.0 * f * f + 3.0 * f * f * f) / 6.0, w2 = 1.0 - w0 - w1 - w3;
        float2 s0 = w0 + w1, s1 = w2 + w3;
        float2 a = (p - 0.5 + w1 / s0) * SunLightmapTexelSize;
        float2 b = (p + 1.5 + w3 / s1) * SunLightmapTexelSize;
        return s0.y * (s0.x * SunLightmap.SampleLevel(LinearSampler, a, 0).r + s1.x * SunLightmap.SampleLevel(LinearSampler, float2(b.x, a.y), 0).r)
             + s1.y * (s0.x * SunLightmap.SampleLevel(LinearSampler, float2(a.x, b.y), 0).r + s1.x * SunLightmap.SampleLevel(LinearSampler, b, 0).r);
    }

    // The same over the static map.
    float StaticBlockerGap(float3 position, float2 gradient, float4 rect)
    {
        float2 step = 0.5 * MaxPenumbra * StaticTexelSize;
        float2 halfTexel = 0.5 * StaticTexelSize;
        float4 corners = float4(dot(float2(-halfTexel.x, halfTexel.y), gradient), dot(halfTexel, gradient),
                                dot(float2(halfTexel.x, -halfTexel.y), gradient), dot(-halfTexel, gradient));
        float sum = 0;
        float count = 0;
        for (int j = 0; j < 4; j++)
        {
            for (int i = 0; i < 4; i++)
            {
                // Snapped to a texel corner, so the gather takes the four texels round it.
                float2 uv = clamp(position.xy + (float2(i, j) - 1.5) * step, rect.xy + halfTexel, rect.zw - halfTexel);
                uv = (floor(uv * (1.0 / StaticTexelSize) - 0.5) + 1.0) * StaticTexelSize;
                float4 stored = StaticShadowMap.GatherRed(PointSampler, uv);
                float4 receiver = min(position.z + dot(uv - position.xy, gradient) + corners, 1.0);
                float4 blocked = stored < receiver ? 1.0 : 0.0;
                sum += dot(blocked, receiver - stored);
                count += dot(blocked, 1.0);
            }
        }
        return count == 0 ? -1.0 : count == 64 ? -2.0 : sum / count;
    }

    // 64 bilinear comparisons on two Vogel disks of the radius (texels), weighted
    // towards the centre like a tent, so the penumbra fades without a rim.
    float StaticFilterDisk(float3 position, float2 gradient, float radius, float4 rect)
    {
        float2 scale = radius * StaticTexelSize;
        float shadow = 0;
        float total = 0;
        float2 twists[2] = { Twist(streams.ShadingPosition.xy, 0.0), Twist(streams.ShadingPosition.xy, 1.0) };
        for (int k = 0; k < 64; k++)
        {
            float r2 = ((k >> 1) + 0.5) / 32.0;
            float a = (k >> 1) * 2.39996;
            float2 e = float2(cos(a), sin(a));
            float2 twist = twists[k & 1];
            float2 d = sqrt(r2) * float2(e.x * twist.x - e.y * twist.y, e.x * twist.y + e.y * twist.x);
            float weight = 1.0 - 0.75 * r2;
            float2 uv = clamp(position.xy + d * scale, rect.xy, rect.zw);
            shadow += weight * StaticTap(uv, position, gradient);
            total += weight;
        }
        return shadow / total;
    }

    // Beyond the far plane (the sea far off) is behind every caster: the cleared
    // depth means nothing is there, so the receiver is held to it.
    float StaticTap(float2 tapUV, float3 position, float2 gradient)
    {
        float depth = min(position.z + dot(tapUV - position.xy, gradient), 1.0);
        return StaticShadowMap.SampleCmpLevelZero(LinearClampCompareLessEqualSampler, tapUV, depth);
    }
};
