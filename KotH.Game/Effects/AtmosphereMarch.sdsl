/// <summary>Fog and clouds along each view ray at half resolution: rgb is the light they add,
/// a the share of the scene still seen (Texture0 depth, Texture1 cloud map). Clouds marched
/// through their thin layer; fog = an exact height part plus 8 steps round the centre; coastal
/// fog low on the water in a ring, 2 to 10 steps. All fog splits at the clouds' depth.</summary>
shader AtmosphereMarch : ImageEffectShader, CloudLayer
{
    float4x4 ClipToRay;     // clip x, y, 1 to the view ray with a view depth of 1
    float2 NearFar;
    float Divisor;          // screen pixels per march pixel (2 at High, the Volumetric setting)
    float3 Eye;
    float3 ToSun;
    float3 SunColor;
    float4 FogHeights;      // start, peak, top, farthest distance
    float4 FogShape;        // density, share far off, centre x, centre z
    float FogRadius;
    float3 FogColor;
    float FogSun;
    float4 Cloud;           // base, thickness, coverage, density
    float4 CloudReach;      // farthest distance, lod per metre, lod of the streaks over the cloudlets, 0
    float2 CloudScale;
    float4 CloudOffset;
    float2 Wind;
    float3 CloudTopColor;
    float3 CloudBottomColor;
    float4 CoastHeights;    // water, top, 0, metres a pixel spans per metre away
    float4 CoastRing;       // radii: starts, full, thins, gone
    float4 CoastShape;      // density, haze share, 1 / repeat of the wisps, texels per metre
    float CoastOffset;
    float3 CoastColor;
    Texture3D<float2> SmokeNoise; // billows' shape, finer cells for the edges (SmokeNoise.cs)
    // Stride's LinearRepeatSampler repeats u and v only: w clamped, the smoke was the same all along z.
    SamplerState SmokeSampler
    {
        Filter = MIN_MAG_MIP_LINEAR;
        AddressU = Wrap;
        AddressV = Wrap;
        AddressW = Wrap;
    };
    float4 Smoke;           // source x, y, z, density (0: none)
    float4 SmokeShape;      // clear below, full from (heights), drift per metre risen, 1 / noise repeat
    float4 SmokeColumn;     // radius at the source, widening per metre risen, umbrella's drift, bounding radius
    float4 SmokeUmbrella;   // radius, middle height, half thickness below and above it
    float4 SmokeMotion;     // noise carried along the wind, risen (repeats), detail's bite, 0
    float3 SmokeLitColor;
    float3 SmokeShadeColor;
    float3 SmokeGlowColor;

    static const int FogSteps = 8;
    static const int MaxSmokeSteps = 64;    // samples inside the plume
    static const float SmokeEdge = 0.1;     // cover below it counts as empty (only rare wisps lived there)
    static const int MaxSmokeStrides = 160; // with the strides through the empty space round it
    static const int CoastSteps = 10;
    static const int MaxCloudSteps = 16;

    // The fog's height profile: 0 up to the start, 1 at the peak, 0 again at the top.
    float Ramp(float h)
    {
        if (h <= FogHeights.x)
            return 0.0;
        if (h <= FogHeights.y)
            return (h - FogHeights.x) / (FogHeights.y - FogHeights.x);
        return saturate((FogHeights.z - h) / (FogHeights.z - FogHeights.y));
    }

    // The profile integrated over height from below.
    float RampIntegral(float h)
    {
        float a = FogHeights.x, p = FogHeights.y, b = FogHeights.z;
        if (h <= a)
            return 0.0;
        if (h <= p)
            return (h - a) * (h - a) / (2.0 * (p - a));
        float s = min(h, b) - p;
        return 0.5 * (p - a) + s - s * s / (2.0 * (b - p));
    }

    // The profile along the ray from t0 to t1, exactly (it is linear in t on each piece).
    float RampAlong(float3 o, float3 d, float t0, float t1)
    {
        if (abs(d.y) < 1e-4)
            return Ramp(o.y) * (t1 - t0);
        return (RampIntegral(o.y + d.y * t1) - RampIntegral(o.y + d.y * t0)) / d.y;
    }

    // The coastal fog's fall-off 1 - smoothstep(0, 1, h) integrated over h from 0.
    float LowIntegral(float h)
    {
        return h - h * h * h + 0.5 * h * h * h * h;
    }

    // Where the ray is between two heights, within [t0, t1]; empty when x > y.
    float2 Slab(float3 o, float3 d, float lo, float hi, float t0, float t1)
    {
        if (abs(d.y) < 1e-6)
            return o.y >= lo && o.y <= hi ? float2(t0, t1) : float2(1.0, 0.0);
        float a = (lo - o.y) / d.y, b = (hi - o.y) / d.y;
        return float2(max(min(a, b), t0), min(max(a, b), t1));
    }

    // The plume's axis at height y: bent downwind above the clear height.
    float2 SmokeAxis(float y)
    {
        return Smoke.xz + Wind * (SmokeShape.z * max(y - SmokeShape.x, 0.0));
    }

    // How deep inside the plume p lies: 1 on the axis, 0 at the edge, below outside; the column widens
    // as it rises into the umbrella, which spreads further downwind. gap: metres at least to SmokeEdge.
    float SmokeCover(float3 p, out float column, out float gap)
    {
        float r = SmokeColumn.x + SmokeColumn.y * max(p.y - SmokeShape.x, 0.0);
        float radial = 1.0 - length(p.xz - SmokeAxis(p.y)) / r;
        // Up into the umbrella's middle: it lies downwind, a neck ending below its floor left a gap.
        column = min(radial, (SmokeUmbrella.y + 0.5 * SmokeUmbrella.w - p.y) / 25.0);
        float2 centre = SmokeAxis(SmokeUmbrella.y) + Wind * SmokeColumn.z;
        float dy = p.y - SmokeUmbrella.y, thick = dy < 0.0 ? SmokeUmbrella.z : SmokeUmbrella.w;
        float umbrella = 1.0 - length(float2(length(p.xz - centre) / SmokeUmbrella.x, dy / thick));
        // The umbrella's gap from its box too: from the flat ellipsoid alone it was its thickness, a crawl.
        float box = max(length(p.xz - centre) - SmokeUmbrella.x, abs(dy) - thick);
        gap = 0.8 * min(max((SmokeEdge - radial) * r, p.y - SmokeUmbrella.y - 0.5 * SmokeUmbrella.w + 25.0 * SmokeEdge),
                        max((SmokeEdge - umbrella) * min(SmokeUmbrella.x, thick), box));
        return max(column, umbrella);
    }

    // Smoke per metre at p: the cover swollen and eaten by the billows, which rise with the plume and
    // drift with the wind; detail and near (0 to 1) bite finer and finest cells out of the edges.
    // Barely any below the clear height (Luca: the zone keeps its view).
    float SmokeAt(float3 p, float cover, float detail, float near)
    {
        float3 q = p * SmokeShape.w - float3(Wind.x * SmokeMotion.x, SmokeMotion.y, Wind.y * SmokeMotion.x);
        // A steep rise at the billows' surface, so they keep a rim the sun can light and shade.
        float billow = SmokeNoise.SampleLevel(SmokeSampler, q, 0).x;
        float dense = saturate(6.0 * (1.5 * cover - (1.0 - billow)));
        float bite = 0.0;
        if (dense > 0.0 && detail > 0.0)
        {
            // Eroded as a remap, so thin edges vanish whole instead of leaving loose flecks.
            bite = (1.0 - SmokeNoise.SampleLevel(SmokeSampler, q * 1.7 + 0.37, 0).y) * SmokeMotion.z * detail;
            // Lumps of a few metres close by, where the coarser ones blurred into a smooth ceiling.
            if (near > 0.0)
                bite = min(bite + (1.0 - SmokeNoise.SampleLevel(SmokeSampler, q * 6.1 + 0.71, 0).y) * SmokeMotion.z * near, 0.9);
            dense = saturate((dense - bite) / (1.0 - bite));
        }
        // The foot's underside lumpy and sharp, from below a billowed ceiling rather than a fade; never
        // lower than the clear height.
        float foot = lerp(SmokeShape.y, SmokeShape.x, saturate(billow - bite));
        // Below it a fixed thin haze, whatever the plume's density.
        return lerp(0.015, Smoke.w, smoothstep(foot, foot + 3.0, p.y)) * dense;
    }

    // Smoke per metre seen t metres away: finer billows close by, faded right at the eye (no wall in
    // the face of whoever jumps in).
    float SmokeSigma(float3 p, float cover, float t)
    {
        return SmokeAt(p, cover, 1.0 - smoothstep(150.0, 400.0, t), 1.0 - smoothstep(40.0, 120.0, t)) * smoothstep(3.0, 12.0, t);
    }

    // Smoke per metre towards the sun from p, cheaper: the base billows only.
    float SmokeShadow(float3 p)
    {
        float column, gap;
        float cover = SmokeCover(p, column, gap);
        return cover > SmokeEdge ? SmokeAt(p, cover, 0.0, 0.0) : 0.0;
    }

    stage override float4 Shading()
    {
        int2 pixel = int2(streams.ShadingPosition.xy);
        int2 full = int2(float2(pixel) * Divisor);
        float z = Texture0.Load(int3(full, 0)).r;
        float2 uv = (float2(full) + 0.5) * Texture0TexelSize;
        float3 ray = mul(float4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, 1.0, 0.0), ClipToRay).xyz;
        float rayLength = length(ray);
        float3 d = ray / rayLength;
        float viewDepth = NearFar.x * NearFar.y / (NearFar.y - z * (NearFar.y - NearFar.x));
        float scene = z >= 1.0 ? 1e9 : viewDepth * rayLength;
        float3 o = Eye;
        // Interleaved gradient noise shifts every pixel's steps, so they do not band.
        float jitter = frac(52.9829189 * frac(dot(float2(pixel), float2(0.06711056, 0.00583715))));

        // Clouds, front to back.
        float3 cloud = 0;
        float through = 1.0;
        float cloudDepth = 0, weight = 0;
        float lowest = Cloud.x, thickness = Cloud.y;
        float2 layer = Slab(o, d, lowest - 0.25 * thickness, lowest + thickness, 0.0, min(scene, CloudReach.x));
        if (Cloud.w > 0.0 && layer.x < layer.y)
        {
            float run = layer.y - layer.x;
            int steps = (int)clamp(ceil(run / 0.75), 3.0, (float)MaxCloudSteps);
            // Long runs inside the layer put their steps near the eye.
            float power = run > 0.75 * MaxCloudSteps ? 2.0 : 1.0;
            float lighting = Cloud.w * 0.6 / max(ToSun.y, 0.1);
            float silver = pow(saturate(dot(d, ToSun)), 8.0);
            for (int i = 0; i < steps && through > 0.02; i++)
            {
                float x = (i + jitter) / steps;
                float t = layer.x + run * pow(x, power);
                float ds = run * power * pow(x, power - 1.0) / steps;
                float3 p = o + d * t;
                // A grazing ray strides far over the map between two pixel rows: read the map
                // that much coarser, or the far cloudlets flicker between rows as the eye moves.
                float lod = log2(max(1.0, t * CloudReach.y / max(abs(d.y), 0.03)));
                float4 cuv = CloudUV(p.xz, Wind, CloudScale, CloudOffset);
                float cell = Texture1.SampleLevel(LinearRepeatSampler, cuv.xy, lod).r;
                float band = Texture1.SampleLevel(LinearRepeatSampler, cuv.zw, max(lod - CloudReach.z, 0.0)).g;
                float top = CloudTop(cell, band, Cloud.z);
                float y = (p.y - lowest) / thickness;
                float fade = smoothstep(0.5, 3.0, t) * (1.0 - smoothstep(0.5 * CloudReach.x, CloudReach.x, t));
                float sigma = Cloud.w * CloudShape(top, y, thickness) * fade;
                if (sigma <= 0.0)
                    continue;
                float alpha = 1.0 - exp(-sigma * ds);
                // Lit by the sun through what lies above in the cloudlet; two tones.
                float sun = exp(-lighting * max(top - y, 0.0) * thickness);
                float3 colour = lerp(CloudBottomColor, CloudTopColor, sun) + 0.35 * silver * sun * CloudTopColor;
                cloud += through * alpha * colour;
                cloudDepth += through * alpha * t;
                weight += through * alpha;
                through *= 1.0 - alpha;
            }
        }
        // Smoke after the clouds (no map has both), through its cylinder only, faded close to the
        // eye: no wall in the face of whoever jumps into it. Empty space is crossed in strides as
        // long as the plume is away, inside in steps that grow with the distance.
        float smokeEnd = min(scene, FogHeights.w);
        float2 os = o.xz - Smoke.xz;
        float As = dot(d.xz, d.xz), Bs = dot(os, d.xz), Cs = dot(os, os) - SmokeColumn.w * SmokeColumn.w;
        float2 span = float2(0.0, smokeEnd);
        if (As > 1e-8)
        {
            float rootS = Bs * Bs - As * Cs;
            span = rootS > 0.0 ? float2(max((-Bs - sqrt(rootS)) / As, 0.0), min((-Bs + sqrt(rootS)) / As, smokeEnd)) : float2(1.0, 0.0);
        }
        else if (Cs > 0.0)
            span = float2(1.0, 0.0);
        span = Slab(o, d, Smoke.y, SmokeUmbrella.y + SmokeUmbrella.w, span.x, span.y);
        if (Smoke.w > 0.0 && span.x < span.y)
        {
            float silver = 0.4 * pow(saturate(dot(d, ToSun)), 6.0);
            float t = span.x, stride = 1.0, outside = -1.0;
            int samples = 0;
            for (int i = 0; i < MaxSmokeStrides && samples < MaxSmokeSteps && t < span.y && through > 0.02; i++)
            {
                float column, gap;
                float cover = SmokeCover(o + d * t, column, gap);
                float ds = clamp(0.012 * t, 1.5, 8.0);
                // Below the clear height only the even haze: long steps, the zone's view stays cheap.
                if (o.y + d.y * t < SmokeShape.x - 2.0)
                    ds = max(ds, 5.0);
                // Rays grazing the column (beside it, or from the zone up its widening, mostly empty
                // rim) crept on and ran out of steps: light wedges, a hole under the umbrella. Outside
                // at least a share of the distance (back to the edge on the way in), through empty
                // billows up to twice as long (longer, or jittered, broke thin wisps into a mesh).
                if (cover <= SmokeEdge)
                {
                    outside = t;
                    t += max(gap, max(ds, 0.05 * t));
                    continue;
                }
                if (outside >= 0.0)
                {
                    float a = outside, b = t;
                    for (int k = 0; k < 3; k++)
                    {
                        float m = 0.5 * (a + b), mColumn, mGap;
                        if (SmokeCover(o + d * m, mColumn, mGap) > SmokeEdge)
                            b = m;
                        else
                            a = m;
                    }
                    t = b;
                    outside = -1.0;
                    cover = SmokeCover(o + d * t, column, gap);
                }
                float3 p = o + d * (t + jitter * ds);
                float sigma = SmokeSigma(p, cover, t);
                if (sigma <= 0.0)
                {
                    t += ds * min(stride, clamp(t / 60.0, 1.0, 2.0));
                    stride = min(stride * 1.5, 2.0);
                    continue;
                }
                stride = 1.0;
                samples++;
                t += ds;
                float alpha = 1.0 - exp(-sigma * ds);
                // Sunlit through what lies towards the sun (two near samples, the plume's bulk further
                // on); the sky lights the edges more than the core; the root glows from the magma.
                // The thin haze needs no shadow samples: half lit.
                float depth = 2.0;
                if (sigma > 0.02)
                {
                    float farColumn, farGap;
                    float far = SmokeCover(p + ToSun * 40.0, farColumn, farGap);
                    depth = 5.0 * SmokeShadow(p + ToSun * 4.0) + 12.0 * SmokeShadow(p + ToSun * 14.0) + 30.0 * Smoke.w * saturate(1.5 * far);
                }
                // Light scattered on through the ash, not only straight from the sun: a second, weaker
                // fall-off keeps the sunny side bright a few metres in (as multiple scattering does).
                float sun = 0.7 * exp(-0.35 * depth) + 0.3 * exp(-0.08 * depth);
                // The billows' thin rims take more sky than their thick middles.
                float rim = 1.25 - 0.6 * saturate(sigma / Smoke.w);
                // Dark ash low in the column, light heads high up: the underside seen from the zone stays dark.
                float tone = lerp(0.5, 1.0, saturate((p.y - SmokeShape.y) / (SmokeUmbrella.y - SmokeShape.y)));
                float3 colour = tone * (SmokeLitColor * sun * (1.0 + silver) + SmokeShadeColor * rim * lerp(1.0, 0.45, saturate(cover)))
                              + SmokeGlowColor * saturate(column) * exp(-(p.y - Smoke.y) / 18.0);
                cloud += through * alpha * colour;
                cloudDepth += through * alpha * t;
                weight += through * alpha;
                through *= 1.0 - alpha;
            }
        }
        float split = weight > 0.0 ? cloudDepth / weight : scene;

        // Fog: the height part exactly, the part round the centre marched.
        float end = min(scene, FogHeights.w);
        split = min(split, end);
        float everywhere = FogShape.x * FogShape.y;
        float before = everywhere * RampAlong(o, d, 0.0, split);
        float after = everywhere * RampAlong(o, d, split, end);
        float reach = 2.5 * FogRadius;
        float2 oc = o.xz - FogShape.zw;
        float A = dot(d.xz, d.xz), B = dot(oc, d.xz), C = dot(oc, oc) - reach * reach;
        float root = B * B - A * C;
        if (root > 0.0 && A > 1e-8)
        {
            root = sqrt(root);
            float2 inside = Slab(o, d, FogHeights.x, FogHeights.z, max((-B - root) / A, 0.0), min((-B + root) / A, end));
            if (inside.x < inside.y)
            {
                float ds = (inside.y - inside.x) / FogSteps;
                float gathered = FogShape.x * (1.0 - FogShape.y);
                for (int i = 0; i < FogSteps; i++)
                {
                    float t = inside.x + (i + jitter) * ds;
                    float3 p = o + d * t;
                    float2 r = p.xz - FogShape.zw;
                    float tau = gathered * Ramp(p.y) * exp(-dot(r, r) / (FogRadius * FogRadius)) * ds;
                    if (t < split)
                        before += tau;
                    else
                        after += tau;
                }
            }
        }
        // Coastal fog: through the slab over the water, inside the ring's outer circle.
        float coastBefore = 0, coastAfter = 0;
        float2 oc2 = o.xz - FogShape.zw;
        float B2 = dot(oc2, d.xz), A2 = dot(d.xz, d.xz);
        float root2 = B2 * B2 - A2 * (dot(oc2, oc2) - CoastRing.w * CoastRing.w);
        if (CoastShape.x > 0.0 && root2 > 0.0 && A2 > 1e-8)
        {
            root2 = sqrt(root2);
            // The ring bounds it, not the fog's reach: the menu's far eye saw that circle cut the sea.
            // The depth buffer (far 20 km) puts the water metres off far away, anew each frame,
            // and the fog is densest right on it: run on by that error (the slab ends at the water).
            float slack = z >= 1.0 ? 0.0 : scene * scene * 2.4e-7 / NearFar.x;
            float2 slab = Slab(o, d, CoastHeights.x, CoastHeights.y, max((-B2 - root2) / A2, 0.0), min((-B2 + root2) / A2, scene + slack));
            if (slab.x < slab.y)
            {
                // Pieces by the run over the water (seen from above it is short). The fall-off
                // with height is integrated exactly on each piece, ring and wisps are read at
                // its middle: jittered steps through the thin slab flickered as the eye moved.
                float across = sqrt(A2);
                int steps = (int)clamp(ceil((slab.y - slab.x) * across / 12.0), 2.0, (float)CoastSteps);
                float ds = (slab.y - slab.x) / steps;
                float span = CoastHeights.y - CoastHeights.x;
                float rise = d.y / span;
                for (int i = 0; i < steps; i++)
                {
                    float ta = slab.x + i * ds, t = ta + 0.5 * ds;
                    float ha = saturate((o.y + d.y * ta - CoastHeights.x) / span);
                    float hb = saturate((o.y + d.y * (ta + ds) - CoastHeights.x) / span);
                    float low = abs(rise) > 1e-4 ? (LowIntegral(hb) - LowIntegral(ha)) / rise : (1.0 - smoothstep(0.0, 1.0, ha)) * ds;
                    float3 p = o + d * t;
                    float r = length(p.xz - FogShape.zw);
                    float ring = smoothstep(CoastRing.x, CoastRing.y, r) * (1.0 - smoothstep(CoastRing.z, CoastRing.w, r));
                    // Read as coarse as a pixel or a piece spans, or far wisps flicker.
                    float lod = log2(max(1.0, max(t * CoastHeights.w, ds * across) * CoastShape.w));
                    float2 w = float2(dot(p.xz, Wind), dot(p.xz, float2(-Wind.y, Wind.x))) * CoastShape.z - float2(CoastOffset, 0.0);
                    float wisp = smoothstep(0.35, 0.75, Texture1.SampleLevel(LinearRepeatSampler, w, lod).b);
                    float tau = CoastShape.x * ring * low * (CoastShape.y + (1.0 - CoastShape.y) * wisp);
                    if (t < split)
                        coastBefore += tau;
                    else
                        coastAfter += tau;
                }
            }
        }

        // Both fogs' colours, mixed by how much of each lies in front of and behind the clouds.
        float glow = pow(saturate(dot(d, ToSun)), 4.0);
        float3 fog = FogColor + FogSun * SunColor * glow;
        float3 coast = CoastColor + FogSun * SunColor * glow;
        float3 fogFront = (fog * before + coast * coastBefore) / max(before + coastBefore, 1e-6);
        float3 fogBack = (fog * after + coast * coastAfter) / max(after + coastAfter, 1e-6);
        float front = exp(-before - coastBefore), back = exp(-after - coastAfter);
        float3 light = fogFront * (1.0 - front) + front * (cloud + through * fogBack * (1.0 - back));
        return float4(light, front * through * back);
    }
};
