<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>KotH.Client</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Steam's flat C API takes pointers (Steam/SteamApi.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- MenuOverlay raises raw pointer input itself, which Avalonia keeps out of its
         reference assemblies; fine while the version stays pinned exactly. -->
    <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
    <NoWarn>$(NoWarn);AVA3001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Stride.Engine" Version="4.4.1" />
    <PackageReference Include="Stride.BepuPhysics" Version="4.4.1" />
    <PackageReference Include="Stride.UI" Version="4.4.1" />
    <PackageReference Include="Stride.Particles" Version="4.4.1" />
    <PackageReference Include="Stride.AssetCompiler" Version="4.4.1" IncludeAssets="build;buildTransitive" />
    <!-- Stride's own Vulkan binding, for DLSS (Rendering/Dlss); the version Stride 4.4.1 uses. -->
    <PackageReference Include="Vortice.Vulkan" Version="3.0.3" />
    <!-- Stride's SDL loader, pointed at the system SDL on Wayland (Rendering/Wayland.cs); Stride 4.4.1's version. -->
    <PackageReference Include="Silk.NET.Core" Version="2.23.0" />
    <!-- SDL's GameController API for gamepads (Gamepad/Pad.cs); Stride 4.4.1's version, already in the build. -->
    <PackageReference Include="Silk.NET.SDL" Version="2.23.0" />
    <!-- The main menu: Avalonia rendered headless by Skia (Menu/MenuOverlay.cs). -->
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <!-- Avalonia's build sends usage statistics home; not from this build. -->
    <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- The main menu's painted pictures (Tools/menu/MenuArt.cs) and fonts (Accuratist + Noto Sans fallbacks). -->
    <AvaloniaResource Include="Menu\Art\*.png;Menu\Fonts\*.otf;Menu\Fonts\*.ttf" />
    <!-- Pan-CJK variable font copied beside the binary (avoids embedding 32 MB into the managed assembly). -->
    <Content Include="Resources\Fonts\NotoSansCJK.ttc" Link="Fonts\NotoSansCJK.ttc" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Localization string tables (17 languages, AOT-safe embedded UTF-8 key=value files). -->
    <EmbeddedResource Include="Localization\Strings\*.txt" LogicalName="Localization/%(Filename)%(Extension)" />
    <!-- Per map the ground the grass stands on (Tools/maps/MapUV, Rendering/GrassField.cs). -->
    <!-- The window icon (Rendering/WindowIcon.cs); KotH.Windows/KotH.ico is the same picture for the exe. -->
    <EmbeddedResource Include="Resources/Icon.png" LogicalName="KotH.Icon.png" />
    <EmbeddedResource Include="Resources/Maps/*Grass.bin" LogicalName="Maps/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources/Maps/*Surface.bin" LogicalName="Maps/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KotH.Shared\KotH.Shared.csproj" />
    <ProjectReference Include="..\ThirdParty\Stride.Voxels\Stride.Voxels.csproj" />
  </ItemGroup>
</Project>
