<!-- Settings, shown by the main menu and the pause menu alike over the whole page: title and tabs,
     the tab's rows in a well that scrolls with the wheel, then Reset (the tab's defaults), Revert,
     Apply and Back. Changes count only after Apply; Back and Revert drop them. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KotH.Client.Menu.SettingsPage"
             x:CompileBindings="True">
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="Title" Text="Settings" />
            <StackPanel Name="Tabs" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" />
        </Grid>
        <Border Grid.Row="1" Classes="Well" Margin="0,20,0,0" Padding="0,8">
            <ScrollViewer Name="Scroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          AllowAutoHide="False">
                <StackPanel Name="Rows" Margin="26,0,30,0" />
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,18,0,0">
            <Button Name="Reset" Classes="Menu Small" Content="Reset" Width="160" />
            <Button Name="Revert" Grid.Column="2" Classes="Menu Small" Content="Revert" Width="160" />
            <Button Name="Apply" Grid.Column="3" Classes="Menu Small" Content="Apply" Width="160" Margin="18,0,0,0" />
            <Button Name="Back" Grid.Column="4" Classes="Menu Small" Content="Back" Width="160" Margin="18,0,0,0" />
        </Grid>
    </Grid>
</UserControl>
