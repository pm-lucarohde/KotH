<!-- Languages: all 17 supported languages shown in their native script; choosing one applies and saves immediately. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KotH.Client.Menu.LanguagesPage"
             x:CompileBindings="True">
    <Border Classes="Well" Padding="18,16">
        <ScrollViewer Name="Scroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      AllowAutoHide="False">
            <WrapPanel Name="Choices" ItemSpacing="14" LineSpacing="14" Margin="8,4,12,8" />
        </ScrollViewer>
    </Border>
</UserControl>
