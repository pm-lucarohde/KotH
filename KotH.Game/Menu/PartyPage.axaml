<!-- Party: the online friends with Invite, who is in the party underneath, Leave party. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KotH.Client.Menu.PartyPage"
             x:CompileBindings="True" ClipToBounds="False">
    <!-- The buttons' pictures reach 24 px past the page's edge: nothing here may clip them. -->
    <UserControl.Styles>
        <Style Selector="UserControl /template/ ContentPresenter">
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="*,Auto">
        <Border Classes="Well" Padding="0,8">
            <Panel Name="Inside">
                <TextBlock Name="Empty" Classes="Hint" Text="No friends online" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Panel>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,18,0,0">
            <TextBlock Name="Status" Classes="Hint" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Name="Leave" Grid.Column="1" Classes="Menu Small" Content="Leave party" Width="210" Margin="18,0,0,0" />
        </Grid>
    </Grid>
</UserControl>
