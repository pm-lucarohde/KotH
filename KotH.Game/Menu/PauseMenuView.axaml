<!-- The menu Escape opens in a game, in parts that PauseMenu shows as overlays in the middle of
     the screen: the buttons on their board, or instead a page (Settings, the friends to invite or the
     players to mute in a Steam round, the lobby's map for the host), or the question before leaving.
     Laid out for a screen 1080 high; the pictures carry 24 px of shadow on every side. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:menu="using:KotH.Client.Menu"
             x:Class="KotH.Client.Menu.PauseMenuView"
             x:CompileBindings="True">
    <Panel Name="Parts">
        <Grid Name="BoardPart" Width="488" Height="730">
            <Panel Name="Board" Width="440" Height="380" Margin="24" VerticalAlignment="Center">
                <Image Source="/Menu/Art/Panel.png" Margin="-24" Stretch="Fill" />
                <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                            KeyboardNavigation.TabNavigation="Cycle">
                    <Button Name="Resume" Classes="Menu" Content="Resume" />
                    <Button Name="Maps" Classes="Menu" Content="Map" IsVisible="False" />
                    <Button Name="Invite" Classes="Menu" Content="Invite friends" IsVisible="False" />
                    <Button Name="Players" Classes="Menu" Content="Players" IsVisible="False" />
                    <Button Name="Settings" Classes="Menu" Content="Settings" />
                    <Button Name="Quit" Classes="Menu" Content="To desktop" />
                    <Button Name="ToMenu" Classes="Menu" Content="Main menu" />
                    <TextBlock Name="Locked" Classes="Hint" Text="You can leave in the lobby after the round."
                               TextWrapping="Wrap" TextAlignment="Center" Width="360" IsVisible="False" />
                </StackPanel>
            </Panel>
        </Grid>

        <Grid Name="ConfirmPart" Width="620" Height="330">
            <Panel Width="572" Height="282" Margin="24">
                <Image Source="/Menu/Art/Wide.png" Margin="-24" Stretch="Fill" />
                <StackPanel Spacing="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Classes="Title" Text="Leave the round?" HorizontalAlignment="Center" FontSize="40" />
                    <TextBlock Classes="Hint" Text="The round is still running; the others play on without you."
                               TextWrapping="Wrap" TextAlignment="Center" Width="440" />
                    <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center">
                        <Button Name="Stay" Classes="Menu Small" Content="Stay" Width="190" />
                        <Button Name="Leave" Classes="Menu Small" Content="Leave" Width="190" />
                    </StackPanel>
                </StackPanel>
            </Panel>
        </Grid>

        <Grid Name="PagePart" Width="870" Height="610">
            <Panel Width="820" Height="560" Margin="24">
                <Image Source="/Menu/Art/Wide.png" Margin="-24" Stretch="Fill" />
                <Grid RowDefinitions="Auto,*,Auto" Margin="50,36,50,34">
                    <TextBlock Name="PageTitle" Classes="Title" Text="Settings" />
                    <menu:SettingsPage Name="SettingsPage" Grid.RowSpan="3" />
                    <Border Name="ListPage" Grid.Row="1" Classes="Well" Margin="0,20,0,0" Padding="0,8">
                        <Panel Name="ListInside">
                            <TextBlock Name="NoRows" Classes="Label" FontSize="28" HorizontalAlignment="Center" Margin="26,10" />
                        </Panel>
                    </Border>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,18,0,0">
                        <TextBlock Name="Status" Classes="Hint" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Name="Back" Grid.Column="1" Classes="Menu Small" Content="Back" Margin="18,0,0,0" />
                    </Grid>
                </Grid>
            </Panel>
        </Grid>
    </Panel>
</UserControl>
