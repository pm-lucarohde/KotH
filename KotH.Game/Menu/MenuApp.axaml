<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KotH.Client.Menu.MenuApp"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://KotH.Game/Menu/MenuTheme.axaml" />
        <StyleInclude Source="avares://KotH.Game/Hud/HudTheme.axaml" />
    </Application.Styles>
</Application>
