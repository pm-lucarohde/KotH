<!-- Find server: filters as drop-downs (access, region, language, modded, mode; their lists open on Drops),
     the open KotH rounds on Steam with the same build, nearest first, a Join per round in a list that
     scrolls with the wheel; a word underneath, Refresh to search again; a direct-IP invite code. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KotH.Client.Menu.FindPage"
             x:CompileBindings="True" ClipToBounds="False">
    <!-- The buttons' pictures reach 24 px past the page's edge: nothing here may clip them. -->
    <UserControl.Styles>
        <Style Selector="UserControl /template/ ContentPresenter">
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <WrapPanel Name="Filters" ItemSpacing="10" LineSpacing="10" Margin="0,0,0,14" />
        <Border Grid.Row="1" Classes="Well" Padding="0,8">
            <Panel Name="Inside">
                <StackPanel Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="26,0">
                    <TextBlock Name="EmptyTitle" Classes="Label" Text="No servers found" HorizontalAlignment="Center" FontSize="28" />
                    <TextBlock Name="EmptyHint" Classes="Hint" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Panel>
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,20,0,0">
            <TextBlock Name="Status" Classes="Hint" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Name="Refresh" Grid.Column="1" Classes="Menu Small" Content="Refresh" Width="190" Margin="18,0,0,0" />
            <!-- A private round's password, asked for when its Join was chosen -->
            <StackPanel Name="Ask" Orientation="Horizontal" Spacing="14" IsVisible="False" VerticalAlignment="Center">
                <TextBlock Classes="Label" Text="Password" VerticalAlignment="Center" />
            </StackPanel>
            <Button Name="JoinPrivate" Grid.Column="1" Classes="Menu Small" Content="Join" Width="190" Margin="18,0,0,0" IsVisible="False" />
        </Grid>
        <!-- Direct IP: a host's invite code (koth://join?ip=…&port=…&key=…), pasted with Ctrl+V -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
            <TextBlock Classes="Label" Text="Invite" VerticalAlignment="Center" Margin="0,0,14,0" />
            <Panel Name="InviteField" Grid.Column="1" />
            <Button Name="JoinInvite" Grid.Column="2" Classes="Menu Small" Content="Join" Width="190" Margin="18,0,0,0" />
        </Grid>
        <!-- An open drop-down's list, over everything below its filter -->
        <Canvas Name="Drops" Grid.RowSpan="4" ZIndex="10" ClipToBounds="False" />
    </Grid>
</UserControl>
