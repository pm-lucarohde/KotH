<!-- Find server: the open KotH rounds on Steam with the same build, on any map, a Join per round;
     a word underneath, More for the next page, Refresh to search again. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KotH.Client.Menu.FindPage"
             x:CompileBindings="True">
    <Grid RowDefinitions="*,Auto">
        <Border Classes="Well">
            <Panel Name="Inside">
                <StackPanel Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                    <TextBlock Name="EmptyTitle" Classes="Label" Text="No servers found" HorizontalAlignment="Center" FontSize="28" />
                    <TextBlock Name="EmptyHint" Classes="Hint" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Panel>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,20,0,0">
            <TextBlock Name="Status" Classes="Hint" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Name="More" Grid.Column="1" Classes="Menu Small" Content="More" Width="170" Margin="18,0,0,0" />
            <Button Name="Refresh" Grid.Column="2" Classes="Menu Small" Content="Refresh" Width="190" Margin="18,0,0,0" />
        </Grid>
    </Grid>
</UserControl>
