<!-- The menu's look, in the figure's colours (Tools/menu/menu_art.py paints the
     pictures): clean cream boards and buttons with a solid lip underneath,
     buttons light up yellow under the pointer, Accuratist type (Luca). -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <FontFamily x:Key="Type">avares://KotH.Game/Menu/Fonts#Accuratist</FontFamily>
        <Color x:Key="Red">#C4231F</Color>
        <Color x:Key="Cream">#F6ECDE</Color>
        <Color x:Key="Green">#3F8F35</Color>
        <Color x:Key="Brown">#5B3A24</Color>
        <Color x:Key="Bamboo">#D9A44C</Color>
        <SolidColorBrush x:Key="RedBrush" Color="{StaticResource Red}" />
        <SolidColorBrush x:Key="CreamBrush" Color="{StaticResource Cream}" />
        <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource Green}" />
        <SolidColorBrush x:Key="BrownBrush" Color="{StaticResource Brown}" />
        <SolidColorBrush x:Key="SoftBrownBrush" Color="#9A7A5F" />
        <SolidColorBrush x:Key="WellBrush" Color="#EADBC5" />

        <!-- Fluent's sliders, switches and boxes in our colours -->
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource Red}" />
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#D2342F" />
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#A81D1A" />
        <SolidColorBrush x:Key="SliderTrackFill" Color="#DCC9AE" />
        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#D3BEA1" />
        <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#D3BEA1" />
        <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource Cream}" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource Red}" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#D2342F" />
        <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#EADBC5" />
        <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#E3D1B6" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#9A7A5F" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#9A7A5F" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{StaticResource Cream}" />
        <x:Double x:Key="SliderHorizontalThumbWidth">26</x:Double>
        <x:Double x:Key="SliderHorizontalThumbHeight">26</x:Double>
        <x:Double x:Key="SliderTrackThemeHeight">8</x:Double>
    </Styles.Resources>

    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Type}" />
    </Style>

    <!-- The menu's big buttons: a painted pill on a lip (7 px, small 6), its
         label centred on the face. Under the pointer or focused it turns
         yellow, nothing else (Luca); pressed, and while its page is open,
         the face sinks into the lip down to 2 px. -->
    <Style Selector="Button.Menu">
        <Setter Property="Width" Value="380" />
        <Setter Property="Height" Value="66" />
        <Setter Property="Padding" Value="0" />
        <!-- The painted pill and its shadow reach 24 past the button's edge. -->
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource BrownBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Type}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- Hit by its own bounds, not by the pictures: once pressed, the shown
                     one was not hit and the release counted only over the label. -->
                <Panel Background="Transparent">
                    <Image Name="Idle" Source="/Menu/Art/Button.png" Margin="-24" Stretch="Fill" IsHitTestVisible="False" />
                    <Image Name="Hot" Source="/Menu/Art/ButtonHot.png" Margin="-24" Stretch="Fill" Opacity="0" IsHitTestVisible="False">
                        <Image.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                            </Transitions>
                        </Image.Transitions>
                    </Image>
                    <Image Name="Down" Source="/Menu/Art/ButtonDown.png" Margin="-24" Stretch="Fill" IsVisible="False" IsHitTestVisible="False" />
                    <ContentPresenter Name="Label" Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="34,0,0,10" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.Menu:pointerover /template/ Image#Hot, Button.Menu:focus-visible /template/ Image#Hot">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- Fluent shrinks a pressed button to 98 %: a click near the edge then
         ended off it and was lost. Ours sinks instead. -->
    <Style Selector="Button.Menu:pressed">
        <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Button.Menu:pressed /template/ Image#Down, Button.Menu.Active /template/ Image#Down">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.Menu:pressed /template/ Image#Idle, Button.Menu.Active /template/ Image#Idle,
                     Button.Menu:pressed /template/ Image#Hot, Button.Menu.Active /template/ Image#Hot">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.Menu:pressed /template/ ContentPresenter#Label, Button.Menu.Active /template/ ContentPresenter#Label">
        <Setter Property="RenderTransform" Value="translate(0px, 5px)" />
    </Style>
    <!-- Behind the load screen (MainMenuView.Light): every picture shown once, so Skia decodes them there. -->
    <Style Selector="Button.Menu.Warm /template/ Image">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.Menu.Small">
        <Setter Property="Width" Value="230" />
        <Setter Property="Height" Value="54" />
        <Setter Property="FontSize" Value="25" />
    </Style>
    <Style Selector="Button.Menu.Small /template/ Image#Idle">
        <Setter Property="Source" Value="/Menu/Art/SmallButton.png" />
    </Style>
    <Style Selector="Button.Menu.Small /template/ Image#Hot">
        <Setter Property="Source" Value="/Menu/Art/SmallButtonHot.png" />
    </Style>
    <Style Selector="Button.Menu.Small /template/ Image#Down">
        <Setter Property="Source" Value="/Menu/Art/SmallButtonDown.png" />
    </Style>
    <Style Selector="Button.Menu.Small /template/ ContentPresenter#Label">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,9" />
    </Style>
    <Style Selector="Button.Menu.Small:pressed /template/ ContentPresenter#Label">
        <Setter Property="RenderTransform" Value="translate(0px, 4px)" />
    </Style>
    <Style Selector="Button.Menu:disabled">
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- Text on the boards -->
    <Style Selector="TextBlock.Title">
        <Setter Property="FontSize" Value="44" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource BrownBrush}" />
    </Style>
    <Style Selector="TextBlock.Label">
        <Setter Property="FontSize" Value="25" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource BrownBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.Hint">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource SoftBrownBrush}" />
    </Style>

    <!-- A sunk well on a board, for lists and groups of settings -->
    <Style Selector="Border.Well">
        <Setter Property="Background" Value="{StaticResource WellBrush}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="BoxShadow" Value="inset 0 3 8 0 #33503018" />
        <Setter Property="Padding" Value="26,18" />
    </Style>

    <!-- The settings' tabs: small pills on a lip like the buttons, the chosen one red -->
    <Style Selector="Border.Tab">
        <Setter Property="Background" Value="#F3E7D6" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="24,8" />
        <Setter Property="BoxShadow" Value="0 4 0 0 #C9AE8C" />
    </Style>
    <Style Selector="Border.Tab TextBlock">
        <Setter Property="FontSize" Value="23" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrownBrush}" />
    </Style>
    <Style Selector="Border.Tab.Chosen">
        <Setter Property="Background" Value="{StaticResource RedBrush}" />
        <Setter Property="BoxShadow" Value="0 4 0 0 #8A1815" />
    </Style>
    <Style Selector="Border.Tab.Chosen TextBlock">
        <Setter Property="Foreground" Value="{StaticResource CreamBrush}" />
    </Style>

    <!-- Fluent's switch is drawn for desktop forms; ours is bigger -->
    <Style Selector="ToggleSwitch">
        <Setter Property="RenderTransformOrigin" Value="0%,50%" />
        <Setter Property="RenderTransform" Value="scale(1.5)" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox.Field">
        <Setter Property="FontFamily" Value="{StaticResource Type}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Height" Value="50" />
        <Setter Property="CornerRadius" Value="25" />
        <Setter Property="Padding" Value="22,11" />
        <Setter Property="Background" Value="#FBF5EC" />
        <Setter Property="BorderBrush" Value="#D3BEA1" />
        <Setter Property="Foreground" Value="{StaticResource BrownBrush}" />
    </Style>
    <Style Selector="TextBox.Field:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="#F1E6D6" />
        <Setter Property="BorderBrush" Value="#DCC9AE" />
    </Style>
</Styles>
