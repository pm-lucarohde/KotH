// KotH patch: the coarser levels of VoxelStorageSparse. Bricks: one thread per
// texel (border included) of the next level for the slots from slotStart on, from
// 2^3 voxels of the finer one, found through the pages. Dense (one voxel per cell,
// in the box from cellOffset): from the 2^3 voxels of the cell's brick at 0.5 m;
// an empty cell is 0.
namespace Stride.Rendering.Voxels
{
    shader SparseMip : ComputeShaderBase, SparseBricks
    {
        stage Texture3D<uint> Pages;
        stage RWBuffer<uint> SlotCells;
        stage Texture3D<float4> ReadAtlas;
        stage RWTexture3D<float4> WriteAtlas;
        stage int3 atlasBricks;
        stage int3 cellCount;
        stage uint readSide;
        stage uint slotStart;
        stage uint brickCount;
        stage int3 cellOffset;
        stage uint rowLength;
        stage uint Dense;

        compose Voxel2x2x2Mipmapper mipmapper;

        float4 Fetch(int3 voxel)
        {
            int3 brick = voxel / (int)readSide;
            if (any(voxel < 0) || any(brick >= cellCount))
                return 0;
            uint page = Pages.Load(int4(brick, 0)).x;
            if (page == 0)
                return 0;
            int3 texel = BrickOrigin(page - 1, atlasBricks, readSide + 1) + voxel - brick * (int)readSide;
            return ReadAtlas.Load(int4(texel, 0));
        }

        float4 Downsample(int3 voxel)
        {
            int3 v = voxel * 2;
            return mipmapper.Mipmap(
                Fetch(v),
                Fetch(v + int3(1, 0, 0)),
                Fetch(v + int3(1, 1, 0)),
                Fetch(v + int3(1, 0, 1)),
                Fetch(v + int3(0, 1, 1)),
                Fetch(v + int3(0, 1, 0)),
                Fetch(v + int3(0, 0, 1)),
                Fetch(v + int3(1, 1, 1)));
        }

        override void Compute()
        {
            if (Dense != 0)
            {
                int3 cell = (int3)streams.DispatchThreadId + cellOffset;
                if (any(cell >= cellCount))
                    return;
                WriteAtlas[cell] = Downsample(cell);
                return;
            }

            uint side = readSide / 2 + 1;
            uint perBrick = side * side * side;
            uint id = streams.DispatchThreadId.x + streams.DispatchThreadId.y * rowLength;
            uint brick = id / perBrick;
            if (brick >= brickCount)
                return;
            uint t = id - brick * perBrick;
            uint slot = slotStart + brick;
            int3 texel = int3(t % side, (t / side) % side, t / (side * side));
            int3 cell = UnpackCell(SlotCells[slot]);
            WriteAtlas[BrickOrigin(slot, atlasBricks, side) + texel] = Downsample(cell * (int)(readSide / 2) + texel);
        }
    };
}
