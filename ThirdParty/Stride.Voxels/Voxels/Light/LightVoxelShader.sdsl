using Stride.Rendering.Lights;
namespace Stride.Rendering.Voxels.VoxelGI
{
    /// <summary>
    /// Defines a Voxel environment light
    /// </summary>
    shader LightVoxelShader : Camera, Texturing, EnvironmentLight, MaterialPixelShadingStream, NormalStream, PositionStream4, Transformation, LightmapBakeStream
    {
        cbuffer PerView.Lighting
        {
            float Intensity;
            float SpecularIntensity;
            // KotH patch: the skybox, lit through the cones' gaps.
            float SkyIntensity;
            float SkySpecularIntensity;
            float SkyMipCount;
            [Color]
            float3 SkyColors[9];
            // KotH patch: capsules the voxels do not hold (the figures), in groups of
            // OccluderGroupSize behind a sphere (centre, reach); each capsule two
            // entries: end a and radius, end b. They darken the bounce and the sky.
            float4 OccluderGroups[12];
            float4 Occluders[192];
            int OccluderGroupCount;
            int OccluderGroupSize;
            float OccluderFade;
        }

        rgroup PerView.Lighting
        {
            TextureCube SkyCubeMap;
            Texture2D Lightmap;     // KotH patch: baked for meshes with a second UV set (KOTH_LIGHTMAP)
        }

        compose VoxelMarchSet diffuseMarcher;
        compose VoxelRadiusMarchMethod specularMarcher;

        override void PrepareEnvironmentLight()
        {
            base.PrepareEnvironmentLight();
            float3 normal = streams.normalWS.xyz;
            float4 sky = float4(normal, 1.0);
#ifdef KOTH_LIGHTMAP
            // KotH patch: the baked voxel light; the figures' capsules on top.
            float4 baked = Lightmap.SampleLevel(LinearSampler, streams.TexCoord1, 0);
            streams.envLightDiffuseColor = baked.rgb;
            sky.w = baked.a;
            if (OccluderGroupCount > 0)
                streams.envLightDiffuseColor *= CapsuleVisibility(streams.PositionWS, normal);
#else
            LiveEnvironmentLight(normal, sky);
#endif
#ifdef KOTH_LIGHTMAP_BAKE
            streams.bakedLight = float4(streams.envLightDiffuseColor, sky.w);
#endif
            if (SkySpecularIntensity > 0.0)
            {
                float3 r = reflect(-streams.viewWS, normal);
                float mip = sqrt(streams.alphaRoughness) * SkyMipCount;
                streams.envLightSpecularColor += SkyCubeMap.SampleLevel(LinearSampler, float3(r.xy, -r.z), mip).rgb * SkySpecularIntensity * sky.w;
            }
        }

        // The voxel light and the sky, live (KotH patches); the lightmap bake leaves out the capsules.
        void LiveEnvironmentLight(float3 normal, inout float4 sky)
        {
            if (Intensity > 0.0)
            {
                float3 worldPos = streams.PositionWS;

                float3 startPos = worldPos + normal * specularMarcher.StepSizeRadius(1.0);

                float4 reflLighting = diffuseMarcher.MarchSky(worldPos, normal, sky);

                streams.envLightDiffuseColor = reflLighting.rgb * Intensity;
                if (SpecularIntensity > 0.0)
                    streams.envLightSpecularColor = specularMarcher.MarchRadius(startPos, reflect(-streams.viewWS, normal), sqrt(streams.alphaRoughness)).rgb * SpecularIntensity;
            }

            // KotH patch: diffuse sky from the SH along the bent normal, specular from the
            // prefiltered cubemap; both scaled by the open fraction. Skybox space flips z.
            if (SkyIntensity > 0.0)
            {
                float3 bent = sky.xyz * rsqrt(max(dot(sky.xyz, sky.xyz), 1e-8));
                streams.envLightDiffuseColor += SkyIrradiance(float3(bent.xy, -bent.z)) * SkyIntensity * sky.w;
            }
#ifndef KOTH_LIGHTMAP_BAKE
            if (OccluderGroupCount > 0)
                streams.envLightDiffuseColor *= CapsuleVisibility(streams.PositionWS, normal);
#endif
        }

        // KotH patch: light left after the capsules near p, their shares multiplied.
        float CapsuleVisibility(float3 p, float3 n)
        {
            float visible = 1.0;
            for (int g = 0; g < OccluderGroupCount; g++)
            {
                float4 group = OccluderGroups[g];
                float3 gd = group.xyz - p;
                if (dot(gd, gd) > group.w * group.w)
                    continue;
                for (int k = 0; k < OccluderGroupSize; k++)
                {
                    int i = 2 * (g * OccluderGroupSize + k);
                    float4 a = Occluders[i];
                    float3 b = Occluders[i + 1].xyz;
                    if (a.w > 0.0)
                        visible *= 1.0 - CapsuleOcclusion(p, n, a.xyz, b, a.w);
                }
            }
            return visible;
        }

        // Cosine-weighted share of the hemisphere over n that a capsule hides, as the
        // sphere on its axis nearest to p, without the horizon cut; faded out up to
        // OccluderFade radii. A point inside counts as on its surface: the figure's
        // own faces look away from the axis, the ground under it gets dark.
        float CapsuleOcclusion(float3 p, float3 n, float3 a, float3 b, float r)
        {
            float3 ab = b - a;
            float t = saturate(dot(p - a, ab) / max(dot(ab, ab), 1e-8));
            float3 d = a + ab * t - p;
            float l = length(d);
            float reach = OccluderFade * r;
            if (l >= reach)
                return 0.0;
            float near = max(l, r);
            float occ = saturate(dot(n, d) / max(l, 1e-4)) * r * r / (near * near);
            return occ * saturate((reach - l) / (0.4 * reach));
        }

        // Same basis as SphericalHarmonicsUtils<3> (coefficients carry the constants).
        float3 SkyIrradiance(float3 d)
        {
            float3 color = SkyColors[0];
            color += SkyColors[1] * d.y;
            color += SkyColors[2] * d.z;
            color += SkyColors[3] * d.x;
            color += SkyColors[4] * d.y * d.x;
            color += SkyColors[5] * d.y * d.z;
            color += SkyColors[6] * (3.0 * d.z * d.z - 1.0);
            color += SkyColors[7] * d.x * d.z;
            color += SkyColors[8] * (d.x * d.x - d.y * d.y);
            return color;
        }
    };
}
