<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="PublishWithSatoriGC" Version="11.0.0-satori.42242472725.2" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>KotH.Linux</RootNamespace>
    <AssemblyName>KotH</AssemblyName>
    <OutputPath>..\Bin\Linux\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <StrideCurrentPackagePath>$(MSBuildThisFileDirectory)..\KotH.Game\KotH.Game.sdpkg</StrideCurrentPackagePath>
    <StridePlatform>Linux</StridePlatform>
    <StrideGraphicsApi>Vulkan</StrideGraphicsApi>
    <PublishAot>true</PublishAot>
    <DlssSdk>$(MSBuildThisFileDirectory)..\.work\dlss\v310.9.16\</DlssSdk>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\KotH.Game\KotH.Game.csproj" />
    <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" ExcludeAssets="all" PrivateAssets="all" />
    <!-- Scripts and serializers are only reached through the asset database,
         which the trimmer cannot see: without these the scene fails to load. -->
    <TrimmerRootAssembly Include="KotH.Game" />
    <TrimmerRootAssembly Include="KotH.Shared" />
    <TrimmerRootAssembly Include="Stride.Voxels" />
    <!-- Steam's library next to the executable (ThirdParty/Steamworks, KotH.Game/Steam). -->
    <!-- DLSS (KotH.Game/Rendering/Dlss): NVIDIA's NGX loader linked in, its DLSS library beside the
         game; both fetched by Tools/dlss/fetch.sh, without them DLSS stays off. -->
    <NativeLibrary Include="$(DlssSdk)lib/Linux_x86_64/libnvsdk_ngx.a" Condition="Exists('$(DlssSdk)lib/Linux_x86_64/libnvsdk_ngx.a')" />
    <DirectPInvoke Include="nvsdk_ngx" Condition="Exists('$(DlssSdk)lib/Linux_x86_64/libnvsdk_ngx.a')" />
    <LinkerArg Include="-lstdc++ -ldl" Condition="Exists('$(DlssSdk)lib/Linux_x86_64/libnvsdk_ngx.a')" />
    <None Include="$(DlssSdk)lib/Linux_x86_64/rel/libnvidia-ngx-dlss.so.310.9.16" Link="libnvidia-ngx-dlss.so.310.9.16"
          Condition="Exists('$(DlssSdk)lib/Linux_x86_64/rel/libnvidia-ngx-dlss.so.310.9.16')"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\ThirdParty\Steamworks\linux64\libsteam_api.so" Link="libsteam_api.so"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
