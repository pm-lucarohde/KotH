<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>KotH.Linux</RootNamespace>
    <AssemblyName>KotH</AssemblyName>
    <OutputPath>..\Bin\Linux\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <StrideCurrentPackagePath>$(MSBuildThisFileDirectory)..\KotH.Game\KotH.Game.sdpkg</StrideCurrentPackagePath>
    <StridePlatform>Linux</StridePlatform>
    <StrideGraphicsApi>Vulkan</StrideGraphicsApi>
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\KotH.Game\KotH.Game.csproj" />
    <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" ExcludeAssets="all" PrivateAssets="all" />
    <!-- Scripts and serializers are only reached through the asset database,
         which the trimmer cannot see: without these the scene fails to load. -->
    <TrimmerRootAssembly Include="KotH.Game" />
    <TrimmerRootAssembly Include="KotH.Shared" />
    <TrimmerRootAssembly Include="Stride.Voxels" />
    <!-- Steam's library next to the executable (ThirdParty/Steamworks, KotH.Game/Steam). -->
    <None Include="..\ThirdParty\Steamworks\linux64\libsteam_api.so" Link="libsteam_api.so"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
