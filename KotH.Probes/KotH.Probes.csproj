<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>KotH.Probes</RootNamespace>
    <OutputPath>..\Bin\Probes\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <StrideCurrentPackagePath>$(MSBuildThisFileDirectory)..\KotH.Shared\KotH.Shared.sdpkg</StrideCurrentPackagePath>
    <StridePlatform>Linux</StridePlatform>
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\KotH.Shared\KotH.Shared.csproj" />
    <TrimmerRootAssembly Include="KotH.Shared" />
  </ItemGroup>
  <ItemGroup>
    <!-- The client's view math, compiled in so ClockProbe measures the camera's own code. -->
    <Compile Include="..\KotH.Game\Player\ViewMath.cs" Link="Client\ViewMath.cs" />
  </ItemGroup>
</Project>
