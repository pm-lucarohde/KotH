<Project>
  <!-- Shared by every KotH project: one framework, one language level. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <NuGetAuditMode>direct</NuGetAuditMode>
    <!-- One instruction set for every NativeAOT build. The simulation's floats
         depend on it: AVX2/FMA code rounds differently from SSE code. Luca's
         choice: x86-64-v2 (SSE4.2), so older CPUs run it too. A JIT build on
         an AVX2 machine matches it only with DOTNET_EnableAVX=0 set. -->
    <IlcInstructionSet>x86-64-v2</IlcInstructionSet>
  </PropertyGroup>
</Project>
