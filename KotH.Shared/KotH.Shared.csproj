<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>KotH.Shared</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Stride.Engine" Version="4.4.0" />
    <PackageReference Include="Stride.BepuPhysics" Version="4.4.0" />
    <PackageReference Include="LiteNetLib" Version="2.1.4" />
    <PackageReference Include="Stride.AssetCompiler" Version="4.4.0" IncludeAssets="build;buildTransitive" />
    <!-- Math.Sin & co. call the C runtime, which differs between Linux and
         Windows: the simulation uses DetMath, BannedSymbols.txt keeps it so. -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>
  <ItemGroup>
    <!-- Generated ground (Tools/maps): triangles too many for a prefab, loaded by WorldBuilder. -->
    <EmbeddedResource Include="Resources/Maps/*Terrain.bin" LogicalName="Maps/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
